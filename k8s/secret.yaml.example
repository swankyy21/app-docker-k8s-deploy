# Copy this to secret.yaml and fill in real values - secret.yaml is
# gitignored, this .example file is what's tracked.
#
# For learning purposes only: values are plaintext here via stringData
# (Kubernetes still stores Secrets as base64, not encrypted, at rest by default).
# In a real cluster, generate this with `kubectl create secret` or a sealed-secrets/external-secrets tool
# instead of committing it to git.
apiVersion: v1
kind: Secret
metadata:
  name: todo-secret
  namespace: todo-app
type: Opaque
stringData:
  # Discrete vars: needed by the postgres image itself to initialize.
  POSTGRES_USER: todo_user
  POSTGRES_PASSWORD: todo_pass
  # Single connection string: what the backend actually consumes. Host
  # "postgres" is this namespace's postgres Service name.
  DATABASE_URL: postgresql+psycopg2://todo_user:todo_pass@postgres:5432/todos
