# In a real cluster, generate this with `kubectl create secret`
apiVersion: v1
kind: Secret
metadata:
  name: todo-secret
  namespace: todo-app
type: Opaque
stringData:
  POSTGRES_USER: todo_user
  POSTGRES_PASSWORD: todo_pass
  DATABASE_URL: postgresql+psycopg2://todo_user:todo_pass@postgres:5432/todos
